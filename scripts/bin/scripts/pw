#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 copy|show|qr|print" >&2
  exit 1
fi

read -r key_file <~/.config/pw/keyfile
read -r database <~/.config/pw/database

if [[ ! -r "$key_file" ]]; then
  echo "Error: key file is not readable: $key_file" >&2
  exit 1
fi

if [[ ! -r "$database" ]]; then
  echo "Error: database is not readable: $database" >&2
  exit 1
fi

IFS= read -r -s -p "Database password: " database_password </dev/tty
printf "\n" >/dev/tty
trap 'unset database_password' EXIT

pw-keepassxc() {
  printf "%s\n" "$database_password" | keepassxc-cli "$@"
}

pw-list() {
  pw-keepassxc ls \
    --quiet \
    --key-file "$key_file" \
    --flatten --recursive \
    "$database"
}

pw-show() {
  pw-keepassxc show \
    --quiet \
    --key-file "$key_file" \
    "$database" \
    "$1"
}

pw-copy() {
  pw-keepassxc clip \
    --quiet \
    --key-file "$key_file" \
    "$database" \
    "$1"
}

pw-print() {
  pw-keepassxc show \
    --quiet \
    --key-file "$key_file" \
    --attributes password \
    --show-protected \
    "$database" \
    "$1"
}

if ! list="$(pw-list)"; then
  echo "Error: failed to list passwords." >&2
  exit 1
fi

selection="$(echo "$list" | fzf)"
if [ -z "$selection" ]; then
  exit 1
fi

case "$1" in
"copy") pw-copy "$selection" ;;
"show") pw-show "$selection" ;;
"qr") pw-print "$selection" | qrencode -t ANSI256 ;;
"print") pw-print "$selection" ;;
esac
