#!/usr/bin/env python3

import argparse
import itertools
import os
import subprocess
import sys
import tempfile
from collections.abc import Generator, Iterable
from pathlib import Path
from typing import Any


def concat[T](iterable: Iterable[Iterable[T]]) -> Iterable[T]:
    return list(itertools.chain.from_iterable(iterable))


def recursive_list_dir(
    top: str, include_dirs: bool, include_files: bool
) -> Generator[str]:
    for root, dirs, files in os.walk(top):
        if include_files:
            for path in files:
                yield os.path.join(root, path)
        if include_dirs:
            for path in dirs:
                yield os.path.join(root, path)


def list_dir(top: str, include_dirs: bool, include_files: bool) -> Generator[str]:
    for entry in os.scandir(top):
        if entry.is_file() and include_files:
            yield os.path.join(top, entry.name)

        if entry.is_dir() and include_dirs:
            yield os.path.join(top, entry.name)


def write_temporary(content: str) -> str:
    with tempfile.NamedTemporaryFile(mode="w", delete=False) as fobj:
        fobj.write(content)
        return fobj.name


def read_file_lines(path: str) -> list[str]:
    with open(path, "r") as fobj:
        return fobj.read().splitlines()


def interact(editor: str, old_paths: list[str]) -> list[str]:
    tmp_path = write_temporary("\n".join(old_paths))
    try:
        subprocess.call([editor, tmp_path])
        new_paths = read_file_lines(tmp_path)
        return new_paths
    finally:
        os.remove(tmp_path)


def rename(old_names: list[str], new_names: list[str], parents: bool) -> None:
    assert len(old_names) == len(new_names)
    for old, new in zip(old_names, new_names, strict=True):
        # Don't rename if the name is unchanged
        if old == new:
            continue

        sys.stdout.write(f'Moving "{old}" to "{new}".\n')
        if not os.path.exists(new):
            if parents:
                os.renames(old, new)
            else:
                os.rename(old, new)
        else:
            sys.stderr.write(f"Warning: file {new} already exists.\n")


def read_from_stdin() -> list[str]:
    return sorted(path.strip() for path in sys.stdin.readlines())


def read_from_paths(args: Any) -> list[str]:
    list_func = recursive_list_dir if args.recursive else list_dir
    paths = concat(list_func(path, args.directories, args.files) for path in args.paths)
    # Negate part number to get deeper paths first so they get
    # renamed before their parent.
    return sorted(paths, key=lambda path: (-len(Path(path).parts), path))


def program(args: Any) -> int:
    old_names = read_from_stdin() if args.paths == ["-"] else read_from_paths(args)
    new_names = interact(args.editor, old_names)

    if len(new_names) == 0:
        sys.stderr.write("Aborting rename due to empty input.\n")
        return 1

    new_count = len(new_names)
    old_count = len(old_names)
    if new_count != old_count:
        sys.stderr.write(
            f"Error: number of lines have changed from {old_count} to {new_count}, exiting.\n"
        )
        return 1

    rename(old_names, new_names, args.parents)
    return 0


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Interactively rename files.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    parser.add_argument(
        "paths",
        nargs="+",
        default=".",
        help="directory to rename files in, specify - to read from standard input",
    )

    parser.add_argument(
        "-p", "--parents", action="store_true", help="make parent directories as needed"
    )

    parser.add_argument(
        "-e",
        "--editor",
        action="store",
        help="the editor to use",
        default=os.environ["EDITOR"],
    )

    parser.add_argument(
        "-r",
        "--recursive",
        action="store_true",
        help="recurseivly rename in sub-directories",
    )

    parser.add_argument(
        "--files", dest="files", action="store_true", help="rename files"
    )
    parser.add_argument(
        "--no-files", dest="files", action="store_false", help="do not rename files"
    )
    parser.set_defaults(files=True)

    parser.add_argument(
        "--directories",
        dest="directories",
        action="store_true",
        help="rename directories",
    )
    parser.add_argument(
        "--no-directories",
        dest="directories",
        action="store_false",
        help="do not rename directories",
    )
    parser.set_defaults(directories=True)

    sys.exit(program(parser.parse_args()))


main()
