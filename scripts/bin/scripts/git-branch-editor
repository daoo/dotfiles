#!/usr/bin/env python3

import os
import shlex
import subprocess
import sys
import tempfile


def git_branches() -> tuple[str | None, list[str]]:
    command = ["git", "branch"]
    output = subprocess.check_output(command)
    raw_branches = output.decode("utf-8").splitlines()

    current_name = None
    branches = []
    for string in raw_branches:
        prefix = string[0:2].strip()
        name = string[2:]
        if prefix == "*":
            current_name = name
        branches.append(name)

    return (current_name, branches)


def write_retained_temporary_file(lines: str) -> str:
    with tempfile.NamedTemporaryFile(mode="w", delete=False) as fwrite:
        fwrite.write(lines)
        return fwrite.name


def read_file(path: str) -> str:
    with open(path, "r") as fread:
        return fread.read()


def edit(lines: str) -> str:
    try:
        tmp_path = write_retained_temporary_file(lines)
        subprocess.check_call(shlex.split(os.environ["EDITOR"]) + [tmp_path])
        commands = read_file(tmp_path)
    finally:
        os.remove(tmp_path)
    return commands


def format_output(current: str | None, branches: list[str]) -> str:
    documentation = """
# git-branch-editor
#
# Commands:
# * = current branch
# s branch = switch to "branch"
# d branch = delete "branch"
# D branch = delete "branch" (even if not merged)
# po branch = push to origin
# u branch upstream = set upstream for "branch" to "upstream"
# uu branch = unset upstream for "branch"
#
# Other lines are treated as branch renaming.
"""

    def f(branch):
        if current == branch:
            return "* " + branch
        else:
            return branch

    branches_text = "\n".join(map(f, sorted(branches)))
    return branches_text + "\n" + documentation


def parse_command(old_branch: str, string: str) -> None | list[str]:
    match string.split():
        case ["*", _]:
            return None  # ignore current branch
        case ["s", branch]:
            return ["git", "switch", branch]
        case ["d", branch]:
            return ["git", "branch", "--delete", branch]
        case ["D", branch]:
            return ["git", "branch", "-D", branch]
        case ["u", branch, upstream]:
            return ["git", "branch", "--set-upstream-to=" + upstream, branch]
        case ["uu", branch]:
            return ["git", "branch", "--unset-upstream", branch]
        case [new_branch] if new_branch != old_branch:
            return ["git", "branch", "--move", old_branch, new_branch]
        case ["po", branch]:
            return ["git", "push", "origin", branch]

    return None


def is_command(line: str) -> bool:
    stripped = line.strip()
    return len(stripped) > 0 and not stripped.startswith("#")


def execute(old_branches: list[str], string: str, dry_run: bool) -> None:
    new_branches = list(filter(is_command, string.splitlines()))
    if len(old_branches) != len(new_branches):
        sys.exit("Error: number of branch lines changed, nothing done.")

    for i in range(len(new_branches)):
        command = parse_command(old_branches[i], new_branches[i])
        if command:
            print(" ".join(command))
            if not dry_run:
                subprocess.call(command)


def main() -> None:
    (current, local) = git_branches()
    execute(local, edit(format_output(current, local)), dry_run=False)


main()
